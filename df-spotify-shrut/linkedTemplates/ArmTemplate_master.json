{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-spotify-shrut"
		},
		"SpotifySql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SpotifySql'"
		},
		"dataLakeLs_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'dataLakeLs'"
		},
		"SpotifySql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlservershrut.database.windows.net"
		},
		"SpotifySql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-spotify"
		},
		"SpotifySql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin123"
		},
		"dataLakeLs_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurespotifyshrut.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-spotify-shrut_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"SpotifySql_password": {
						"value": "[parameters('SpotifySql_password')]"
					},
					"dataLakeLs_accountKey": {
						"value": "[parameters('dataLakeLs_accountKey')]"
					},
					"SpotifySql_properties_typeProperties_server": {
						"value": "[parameters('SpotifySql_properties_typeProperties_server')]"
					},
					"SpotifySql_properties_typeProperties_database": {
						"value": "[parameters('SpotifySql_properties_typeProperties_database')]"
					},
					"SpotifySql_properties_typeProperties_userName": {
						"value": "[parameters('SpotifySql_properties_typeProperties_userName')]"
					},
					"dataLakeLs_properties_typeProperties_url": {
						"value": "[parameters('dataLakeLs_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}